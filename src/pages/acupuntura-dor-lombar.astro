  .art-alert ul { list-style: none; }
  .art-alert li { font-size: 0.95rem; line-height: 1.65; margin-bottom: 0.7rem; padding-left: 1.1rem; position: relative; }
  .art-alert li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 5px; height: 5px; background: var(--coral); border-radius: 50%; }
