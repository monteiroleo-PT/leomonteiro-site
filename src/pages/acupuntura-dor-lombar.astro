  .art-cta { background: var(--ink-deep); padding: clamp(2rem, 4vw, 2.75rem); margin: 2.5rem 0; text-align: center; }
  .art-cta .eyebrow { color: var(--teal-light); }
  .art-cta h3 { color: var(--cream); margin: 0.75rem 0; }
  .art-cta p { color: #C9D6DB; font-size: 0.95rem; margin-bottom: 1.5rem; }

  .art-faq details { border-bottom: 1px solid var(--border); }
